* {
    /* Flexoki light */
    bg:           #FFFCF0E6;
    bg-solid:     #FFFCF0;
    bg-alt:       #F2F0E5;
    bg-surface:   #E6E4D9;
    fg:           #100F0F;
    fg-muted:     #6F6E69;

    hl-bg:        #E6E4D9;
    hl-fg:        #100F0F;

    accent-color: #205EA6;

    red:          #AF3029;
    orange:       #BC5215;
    yellow:       #AD8301;
    green:        #66800B;
    cyan:         #24837B;
    blue:         #205EA6;
    purple:       #5E409D;
    magenta:      #A02F6F;
}
