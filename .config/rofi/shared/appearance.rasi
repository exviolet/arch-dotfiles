@import "../colors.rasi"
@import "settings.rasi"

* {
    font: @font-base;
}

window {
    transparency:     "real";
    border-radius:    @b-radius;
    background-color: @bg;
    color:            @fg;
    border:           @w-border;
    border-color:     @accent-color;
    padding:          @w-padding;
}

mainbox {
    spacing:          @g-spacing;
    margin:           @g-margin;
    padding:          @g-padding;
    background-color: transparent;
    children:         [ "inputbar", "listview", "message" ];
}

inputbar {
    spacing:          @g-spacing;
    background-color: transparent;
    children:         [ "prompt", "entry" ];
}

prompt {
    text-color:       @fg;
    background-color: transparent;
}

entry {
    placeholder:       "Search";
    text-color:        @fg;
    placeholder-color: @fg-muted;
    background-color:  transparent;
}

listview {
    columns:          1;
    lines:            8;
    fixed-height:     true;
    fixed-columns:    true;
    cycle:            false;
    scrollbar:        false;
    spacing:          @g-spacing;
    border:           0px solid;
    background-color: transparent;
}

element {
    spacing:          @g-spacing;
    margin:           @g-margin;
    padding:          @g-padding;
    border:           0px solid;
    border-radius:    @b-radius;
    background-color: transparent;
    text-color:       @fg;
    cursor:           pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @hl-bg;
    text-color:       @hl-fg;
    border:           1px solid;
    border-color:     @accent-color;
}

element selected.active {
    background-color: @hl-bg;
    text-color:       @hl-fg;
    border:           1px solid;
    border-color:     @accent-color;
}

element-icon {
    size:             @icon-size;
    horizontal-align: 0.5;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.0;
    vertical-align:   0.5;
    text-color:       inherit;
    background-color: transparent;
}

message {
    background-color: transparent;
    border:           0px solid;
}

textbox {
    text-color:       @fg-muted;
    background-color: transparent;
}

scrollbar {
    background-color: transparent;
}

mode-switcher {
    background-color: transparent;
}
