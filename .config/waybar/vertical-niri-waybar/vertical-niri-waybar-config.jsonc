{
    "position": "right",
    "layer": "top",
    "width": 38,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,

    "modules-left": [
        "custom/logo",
        "niri/workspaces",
        "mpris"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/main-container"
    ],

    "custom/logo": {
        "format": "󰮠",
        "on-click": "systemctl --user restart waybar.service",
        "tooltip": false
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "default": "󰧞",
            "active": "󰍹"
        },
        "all-outputs": true
    },

    "mpris": {
        "format": "{player_icon}",
        "player-icons": {
            "default": "",
            "chromium": "",
            "spotify": "",
            "firefox": "󰈹"
        },
        "tooltip-format": "{title} - {artist}"
    },

    "clock": {
        "interval": 1,
        "format": "{:%H\n%M}",
        "format-alt": "{:%d\n%m\n%y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "group/main-container": {
        "orientation": "vertical",
        "modules": [
            "group/brightness",
            "group/audio",
            "group/utils",
            "group/hardware",
            "niri/language",
            "battery",
            "tray"
        ]
    },

    "group/brightness": {
        "orientation": "inherit",
        "modules": [
            "backlight",
            "backlight/slider"
        ]
    },

    "group/audio": {
        "orientation": "inherit",
        "modules": [
            "pulseaudio",
            "pulseaudio/slider"
        ]
    },

    "group/utils": {
        "orientation": "vertical",
        "drawer": { "transition-duration": 500, "children-class": "drawer-item", "transition-left-to-right": true },
        "modules": [ "network", "bluetooth" ]
    },

    "group/hardware": {
        "orientation": "vertical",
        "drawer": { "transition-duration": 500, "children-class": "drawer-item", "transition-left-to-right": true },
        "modules": [ "cpu", "memory", "disk" ]
    },

    "cpu": {
        "format": "{icon}",
        "format-icons": [
            "<span size='14pt'>⠁</span>",
            "<span size='14pt'>⠉</span>",
            "<span size='14pt'>⠙</span>",
            "<span size='14pt'>⠛</span>",
            "<span size='14pt'>⠟</span>",
            "<span size='14pt'>⠿</span>"
        ],
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "CPU Frequency: {avg_frequency} GHz",
        "on-click": "alacritty -e btm"
    },

    "memory": { "format": "󰍛" },
    "disk": { "format": "󰋊", "path": "/" },

    "network": {
        "format-icons": {
            "wifi": [
                "<span size='12pt'>󰤯</span>",
                "<span size='12pt'>󰤟</span>",
                "<span size='12pt'>󰤢</span>",
                "<span size='12pt'>󰤥</span>",
                "<span size='12pt'>󰤨</span>"
            ],
            "ethernet": "<span size='12pt'>󰈀</span>",
            "disabled": "<span size='12pt'>󰤭</span>",
            "disconnected": "<span size='12pt'>󰤩</span>"
        },
        "format-wifi": "{icon}",
        "format-ethernet": "{icon}",
        "format-disconnected": "{icon}",
        "format-disabled": "{icon}",
        "interval": 5,
        "tooltip-format": "{essid}\t{gwaddr}",
        "on-click-right": "nm-connection-editor",
        "tooltip": true,
        "max-length": 20
    },

    "bluetooth": {
        "interval": 5,
        "format-on": "<span size='12pt'>󰂯</span>",
        "format-off": "<span size='12pt'>󰂲</span>",
        "format-disabled": "<span size='12pt'>󰂲</span>",
        "format-connected": "<span size='12pt'>󰂱</span>",
        "format-no-controller": "<span size='12pt'>󰂯</span>",
        "tooltip": true,
        "tooltip-format": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_address} | Battery: {device_battery_percentage}%",
        "on-click-right": "blueman-manager"
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "vertical"
    },

    "pulseaudio": {
        "interval": 1,
        "format": "{icon}",
        "format-icons": [
            "<span size='12pt'>󰕿</span>",
            "<span size='12pt'>󰖀</span>",
            "<span size='12pt'>󰕾</span>"
        ],
        "format-muted": "<span size='12pt'>󰝟</span>",
        "on-click-right": "pavucontrol -t 3",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "reverse-scrolling": true,
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%\n{desc}",
        "ignored-sinks": [ "Easy Effects Sink" ]
    },

    "backlight/slider": {
        "min": 0,
        "max": 100,
        "orientation": "vertical",
        "device": "intel_backlight"
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "format-icons": [ "󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠" ],
        "reverse-scrolling": true,
        "smooth-scrolling-threshold": 0.2,
        "tooltip": false
    },

    "battery": {
        "interval": 5,
        "states": { "critical": 10 },
        "format": "{icon}",
        "format-icons": [
            "<span size='12pt'>󰁺</span>",
            "<span size='12pt'>󰁻</span>",
            "<span size='12pt'>󰁼</span>",
            "<span size='12pt'>󰁽</span>",
            "<span size='12pt'>󰁾</span>",
            "<span size='12pt'>󰁿</span>",
            "<span size='12pt'>󰂀</span>",
            "<span size='12pt'>󰂁</span>",
            "<span size='12pt'>󰂂</span>",
            "<span size='12pt'>󰁹</span>"
        ],
        "format-charging": "<span size='12pt'>󰂄</span>",
        "format-plugged": "<span size='12pt'>󰚥</span>",
        "format-critical": "<span size='12pt'>󰂃</span>",
        "tooltip": true,
        "tooltip-format": "Charge: {capacity}%",
        "tooltip-format-charging": "Charging: {capacity}%"
    },

    "niri/language": {
        "format": "{}",
        "format-en": "<span color='#d14d41'>US</span>",
        "format-ru": "<span color='#4385BE'>RU</span>",
        "format-kk": "<span color='#D0A215'>KZ</span>"
    },

    "tray": { "icon-size": 13, "spacing": 4 }
}
