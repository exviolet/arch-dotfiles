pragma Singleton

import Quickshell
import Quickshell.Io
import QtCore
import QtQuick

Singleton {
    id: root

    readonly property var palettes: [
        { "id": "classic", "title": "Классическая", "subtitle": "Красный акцент · режим системы",
          "accent": "#d14d41" },
        { "id": "neutral-light", "title": "Flexoki Light", "subtitle": "Тёплая бумага · тёмные чернила",
          "accent": "#575653", "inactiveRing": "#9f9d96" },
        { "id": "neutral-dark", "title": "Flexoki Dark", "subtitle": "Чернильный фон · тёплый светлый текст",
          "accent": "#b7b5ac", "inactiveRing": "#575653" }
    ]

    readonly property var savedChoice: root.palettes.find(palette => palette.id === store.paletteId)
        ?? root.palettes[0]
    readonly property string savedPalette: root.savedChoice.id
    readonly property var themeWallpapers: {
        try {
            return JSON.parse(store.wallpapersJson) || ({})
        } catch (error) {
            return ({})
        }
    }
    readonly property string savedWallpaper: String(root.themeWallpapers[root.savedPalette] || "")
    readonly property string activePalette: root.previewPalette || root.savedPalette
    readonly property bool dark: root.activePalette === "classic"
        ? root.systemDark : root.activePalette === "neutral-dark"

    property bool systemDark: true
    property string previewPalette: ""
    property var previewOwner: null

    function setPreview(owner: var, paletteId: string): void {
        if (paletteId !== "") {
            root.previewOwner = owner
            root.previewPalette = paletteId
        } else if (root.previewOwner === owner) {
            root.previewPalette = ""
            root.previewOwner = null
        }
    }

    function savePalette(paletteId: string): void {
        store.paletteId = paletteId
        store.sync()
        root.syncNiriFocusRing()
        if (root.savedWallpaper !== "") WallpaperService.apply(root.savedWallpaper)
    }

    function rememberWallpaper(path: string): void {
        const next = Object.assign({}, root.themeWallpapers)
        next[root.savedPalette] = path
        store.wallpapersJson = JSON.stringify(next)
        store.sync()
    }

    function syncNiriFocusRing(): void {
        const palette = root.savedChoice
        let text = "// Generated by Quickshell from the saved palette.\n"
        if (palette.inactiveRing) {
            // Equal stops override the classic gradient without editing layout.kdl.
            text += "layout {\n"
                + "    focus-ring {\n"
                + `        active-gradient from="${palette.accent}" to="${palette.accent}"\n`
                + `        inactive-color "${palette.inactiveRing}"\n`
                + "    }\n}\n"
        }

        if (niriColors.text() !== text) niriColors.setText(text)
    }

    Component.onCompleted: Qt.callLater(root.syncNiriFocusRing)

    FileView {
        id: niriColors

        path: Quickshell.env("HOME") + "/.cache/niri/quickshell-colors.kdl"
        blockLoading: true
        blockWrites: true
        printErrors: false
        onSaveFailed: error => console.warn("Could not write Niri focus ring colors:", error)
    }

    Settings {
        id: store

        location: "file://" + Quickshell.stateDir + "/appearance.ini"
        property string paletteId: "classic"
        property string wallpapersJson: "{}"
    }

    function applyScheme(text: string): void {
        const value = String(text)
        if (value.indexOf("prefer-dark") !== -1) root.systemDark = true
        else if (value.indexOf("prefer-light") !== -1 || value.indexOf("default") !== -1) root.systemDark = false
    }

    Process {
        id: initialRead

        command: ["/usr/sbin/gsettings", "get", "org.gnome.desktop.interface", "color-scheme"]
        running: true

        stdout: StdioCollector {
            onStreamFinished: root.applyScheme(text)
        }
    }

    // Long-lived: one line per change, for as long as the shell runs.
    Process {
        id: watcher

        command: ["/usr/sbin/gsettings", "monitor", "org.gnome.desktop.interface", "color-scheme"]
        running: true

        stdout: SplitParser {
            onRead: line => root.applyScheme(line)
        }
    }

    // Flexoki by Steph Ango: https://stephango.com/flexoki
    readonly property bool classic: root.activePalette === "classic"
    readonly property color background: root.classic ? (root.dark ? "#171817" : "#f4f2ee")
        : (root.dark ? "#100f0f" : "#fffcf0")
    readonly property color surface: root.classic ? (root.dark ? "#222321" : "#e9e6df")
        : (root.dark ? "#1c1b1a" : "#f2f0e5")
    readonly property color raisedSurface: root.classic ? (root.dark ? "#292a28" : "#dfdcd5")
        : (root.dark ? "#282726" : "#e6e4d9")
    readonly property color foreground: root.classic ? (root.dark ? "#f0efeb" : "#1d1e1c")
        : (root.dark ? "#cecdc3" : "#100f0f")
    readonly property color mutedForeground: root.classic ? (root.dark ? "#9c9d98" : "#666862")
        : (root.dark ? "#b7b5ac" : "#403e3c")
    readonly property color subtleForeground: root.classic ? (root.dark ? "#8f918b" : "#6e706a")
        : (root.dark ? "#9f9d96" : "#575653")
    readonly property color border: root.classic ? (root.dark ? "#343633" : "#d6d3cc")
        : (root.dark ? "#403e3c" : "#cecdc3")
    readonly property color track: root.classic ? (root.dark ? "#30322f" : "#dedbd4")
        : (root.dark ? "#343331" : "#dad8ce")
    readonly property color accent: root.palettes.find(palette => palette.id === root.activePalette).accent
    readonly property color accentForeground: root.classic ? "#080808" : (root.dark ? "#100f0f" : "#fffcf0")
    readonly property color alertAccent: root.classic ? root.accent : (root.dark ? "#e8705f" : "#af3029")
    readonly property color warningAccent: root.classic ? "#d08a32" : (root.dark ? "#ec8b49" : "#9d4310")
    readonly property color successAccent: root.classic ? root.layoutUs : (root.dark ? "#879a39" : "#536907")
    readonly property color layoutUs: root.classic ? "#356ea3" : (root.dark ? "#4385be" : "#205ea6")
    readonly property color layoutRu: root.classic ? (root.dark ? "#b53f37" : "#a93832")
        : (root.dark ? "#8b7ec8" : "#5e409d")
    readonly property color layoutKk: root.classic ? (root.dark ? "#d0a13c" : "#bd841e")
        : (root.dark ? "#d0a215" : "#ad8301")

    function layoutForeground(code: string): color {
        if (root.classic) return code === "KK" ? "#171817" : "#ffffff"
        return code === "KK" ? "#100f0f" : root.accentForeground
    }
}
